{
  "name": "@sammy-pack/source-rabbitmq",
  "version": "0.1.0-alpha.0",
  "description": "Optional RabbitMQ (AMQP 0-9-1) queue-source adapter for sammy-pack. Consumes a queue and delivers each message to a sammy-pack `queue` trigger over HTTP, acking only after a 2xx and nacking (requeue / dead-letter) otherwise. amqplib is this package's own dependency \u2014 never the core's.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "sammy-source-rabbitmq": "dist/bin/run.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "sammy-pack",
    "queue",
    "rabbitmq",
    "amqp",
    "amqplib",
    "adapter",
    "broker",
    "orchestration"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qvhn/sammy-pack.git",
    "directory": "app/packages/source-rabbitmq"
  },
  "dependencies": {
    "amqplib": "^0.10.4"
  },
  "peerDependencies": {
    "@sammy-pack/sdk": ">=0.1.0-alpha.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.5",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0"
  },
  "bugs": {
    "url": "https://github.com/qvhn/sammy-pack/issues"
  },
  "homepage": "https://github.com/qvhn/sammy-pack#readme"
}
