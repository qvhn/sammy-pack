# Settings the add-on demos need. Load them into the shell that starts the
# server:
#
#   set -a; source demo/demo.env; set +a; ./sammy-pack restart
#
# Every value is a local-demo default — nothing here is a secret.

# code.run in ALLOWLIST mode: only these commands, run without a shell.
SAMMY_CODE_RUN_ALLOW="node --test"

# Hosts an `http` step may call (the demo inbox, demo/sink.mjs).
SAMMY_HTTP_ALLOWED_HOSTS="127.0.0.1"

# Where approval links in notify.onGate messages point.
SAMMY_PUBLIC_URL="http://localhost:5173"

# Salt for scrub.hashFields (a demo value — use a real secret in production).
SAMMY_SCRUB_SALT="demo-salt-not-a-secret"

# Per-run worktrees OUTSIDE this checkout. Under it, an agent working on
# another repository also picks up sammy-pack's own CLAUDE.md from the
# parent directories — instructions meant for this repo, not that one.
SAMMY_WORKTREE_DIR="$HOME/.sammy-pack/worktrees"

# Personal settings (never committed) go in demo/demo.local.env — gitignored —
# sourced after this file, e.g. the git identity for repositories cloned from
# the Run dialog (otherwise your global git identity is used):
#   SAMMY_GIT_USER_NAME="your-name"
#   SAMMY_GIT_USER_EMAIL="you@example.com"
